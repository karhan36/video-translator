[Unit]
Description=Video translator telegram bot (Yandex SpeechKit)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/video-translator
# venv/bin в PATH: иначе бот не находит yt-dlp, он ставится только внутрь venv
Environment=PATH=/opt/video-translator/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/video-translator/venv/bin/python /opt/video-translator/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vot-bot

[Install]
WantedBy=multi-user.target
